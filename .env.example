# Copy this file to .env and fill in your API keys
# DO NOT commit .env to version control

# RapidAPI Key for YouTube and Shazam APIs
# Get your key at: https://rapidapi.com
VITE_RAPIDAPI_KEY=your_rapidapi_key_here

# YouTube Data API v3 (via RapidAPI)
VITE_YOUTUBE_HOST=youtube-v31.p.rapidapi.com

# Shazam API (via RapidAPI)
VITE_SHAZAM_HOST=shazam-core.p.rapidapi.com
